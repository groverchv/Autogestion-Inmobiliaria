# ─── Base de datos ────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=inmobiliaria_corporativo
DB_USER=postgres
DB_PASSWORD=cambiar

SERVER_PORT=8081

# ─── JWT del panel admin corporativo ──────────────────────────────
JWT_SECRET=cambiar-por-secret-de-al-menos-32-caracteres

# ─── CORS (orígenes del frontend SvelteKit) ───────────────────────
CORS_ORIGINS=http://localhost:5174,http://localhost:4173

# ─── Admin inicial ────────────────────────────────────────────────
ADMIN_EMAIL=admin@inmobiliaria360.com
ADMIN_PASSWORD=Admin2026!
ADMIN_NOMBRE=Administrador

# ─── Cloudinary (subida de imágenes del CMS) ──────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=corporativo

# ─── Correo saliente (Gmail con contraseña de aplicación) ─────────
# Para que te lleguen los mensajes de clientes a tu correo:
#   1. Activa verificación en 2 pasos en tu cuenta de Google
#   2. Genera una "contraseña de aplicación" en
#      https://myaccount.google.com/apppasswords
#   3. MAIL_USERNAME = tu Gmail · MAIL_PASSWORD = los 16 caracteres
#   4. NOTIF_EMAIL_DESTINO = el correo donde quieres recibir los avisos
#      (si lo dejas vacío, se usa ADMIN_EMAIL como respaldo)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=tu-correo@gmail.com
MAIL_PASSWORD=app-password-de-16-caracteres
NOTIF_EMAIL_DESTINO=tu-correo@gmail.com
# Verificación: POST /api/corp/admin/email-test (con token admin)

# ─── Web Push ─────────────────────────────────────────────────────
PUSH_SUBJECT=mailto:contacto@inmobiliaria360.com

# ─── Rate limit (req/min por IP) ──────────────────────────────────
RATE_LIMIT_PUBLIC_POST=10
# Intentos de login permitidos por minuto
RATE_LIMIT_AUTH=5

# ─── URL pública del frontend (enlaces en correos: baja/confirmar) ─
FRONTEND_URL=http://localhost:5174

# ─── Swagger/OpenAPI (false en producción) ────────────────────────
SWAGGER_ENABLED=true

# Agente IA (chat del asistente corporativo). Con al menos una llave se habilita.
GROQ_API_KEY=
GEMINI_API_KEY=
AGENTE_HABILITADO=true
# AGENTE_MODELO=llama-3.3-70b-versatile
# AGENTE_GEMINI_MODELO=gemini-2.0-flash
