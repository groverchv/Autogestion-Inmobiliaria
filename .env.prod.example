# ═══════════════════════════════════════════════════════════════
# Plantilla .env.prod — copiar a .env.prod en el servidor y llenar.
# NUNCA commitear .env.prod (ya está en .gitignore).
# ═══════════════════════════════════════════════════════════════

# ── Supabase (un proyecto, dos databases, mismas credenciales) ──
# Host: db.<ref>.supabase.co  |  Puerto: 5432  |  SSL obligatorio
DATABASE_URL=postgresql://postgres:<SUPABASE_PASSWORD>@db.<ref>.supabase.co:5432/inmobiliaria?sslmode=require

DB_HOST=db.<ref>.supabase.co
DB_NAME=inmobiliaria_corporativo
DB_USER=postgres
DB_PASSWORD=<SUPABASE_PASSWORD>
DB_PARAMS=?sslmode=require

# ── Django operativo ──
DJANGO_SECRET_KEY=<generar: python -c "import secrets; print(secrets.token_urlsafe(50))">
DJANGO_ALLOWED_HOSTS=tudominio.com,www.tudominio.com,<IP_ELASTICA>
CORS_ALLOWED_ORIGINS=https://tudominio.com,https://www.tudominio.com
CSRF_TRUSTED_ORIGINS=https://tudominio.com,https://www.tudominio.com

# ── Stripe LIVE (modo real, no test) ──
STRIPE_PUBLIC_KEY=pk_live_...
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...   # del webhook https://tudominio.com/api/pagos/stripe/webhook/
STRIPE_TASA_USD_BOB=6.96

# ── URLs públicas (nginx termina TLS en el dominio) ──
PUBLIC_SITE_URL=https://tudominio.com
PUBLIC_APP_URL=https://tudominio.com/app
FRONTEND_URL=https://tudominio.com

# ── Spring Boot corporativo ──
JWT_SECRET=<generar: python -c "import secrets; print(secrets.token_urlsafe(50))">
CORS_ORIGINS=https://tudominio.com
ADMIN_EMAIL=admin@tudominio.com
ADMIN_PASSWORD=<password-fuerte-admin>

# ── Correo (contraseña de aplicación de Gmail, NO la normal) ──
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=groverchoquevillca80@gmail.com
MAIL_PASSWORD=<app-password-google>
NOTIF_EMAIL_DESTINO=groverchoquevillca80@gmail.com

# ── Cloudinary (mismas credenciales de dev) ──
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── IA / agente ──
GROQ_API_KEY=
GEMINI_API_KEY=

# ── Blockchain (true = simulado, sin red Fabric) ──
SIMULATE_BLOCKCHAIN=true
